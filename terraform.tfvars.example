# ---------------------------------------------------------------------------
# Project & Region
# ---------------------------------------------------------------------------
project_id  = "GCP_PROJECT_ID"
region      = "europe-west1"
zone        = "europe-west1-b"
prefix      = "tfe"
environment = "prod"

# ---------------------------------------------------------------------------
# GKE Cluster
# Node must have enough allocatable CPU for TFE (requests 4 CPU).
# n2-standard-8 provides ~7.9 vCPU allocatable — minimum recommended.
# ---------------------------------------------------------------------------
node_machine_type      = "n2-standard-8"
node_disk_size_gb      = 100
node_count             = 1
node_min_count         = 1
node_max_count         = 3
subnet_cidr            = "10.10.0.0/20"
pods_cidr              = "10.20.0.0/16"
services_cidr          = "10.30.0.0/20"
master_ipv4_cidr_block = "172.16.0.0/28"

# ---------------------------------------------------------------------------
# DNS — existing Cloud DNS managed zone in your GCP project
# Run: gcloud dns managed-zones list --project=<project-id>
# ---------------------------------------------------------------------------
dns_zone_name = "REPLACE_WITH_EXISTING_ZONE_NAME"   # e.g. my-dns-zone
tfe_subdomain = "tfe"                                # results in tfe.<zone-dns-name>

# ---------------------------------------------------------------------------
# ACME / TLS
# Authentication uses Application Default Credentials — no key file needed.
# Run: gcloud auth application-default login
#
# Use staging URL for testing to avoid Let's Encrypt rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Switch to production when ready:
#   https://acme-v02.api.letsencrypt.org/directory
# ---------------------------------------------------------------------------
acme_server_url   = "https://acme-staging-v02.api.letsencrypt.org/directory"
acme_email        = "REPLACE_WITH_YOUR_EMAIL"
cert_organization = "REPLACE_WITH_YOUR_ORG"

# ---------------------------------------------------------------------------
# Terraform Enterprise
# Check https://helm.releases.hashicorp.com for latest chart version.
# Image registry: images.releases.hashicorp.com (license key is the password)
# ---------------------------------------------------------------------------
tfe_namespace           = "terraform-enterprise"
tfe_chart_version       = "1.6.8"
tfe_image_tag           = "v202501-1"   # Replace with desired TFE release tag
tfe_encryption_password = "REPLACE_WITH_STRONG_ENCRYPTION_PASSWORD"

# !! SENSITIVE — do NOT commit real values !!
# tfe_license = "02MV4UU43BK5H..."   # Paste your license string

# ---------------------------------------------------------------------------
# Cloud SQL (PostgreSQL 16)
# ---------------------------------------------------------------------------
db_tier               = "db-custom-2-7680"   # 2 vCPU, 7.5 GB RAM
db_disk_size_gb       = 50
tfe_database_name     = "tfe"
tfe_database_user     = "tfe"
tfe_database_password = "REPLACE_WITH_STRONG_DB_PASSWORD"

# ---------------------------------------------------------------------------
# Redis (Memorystore) — no password / TLS required
# redis_alt_zone must differ from var.zone above
# ---------------------------------------------------------------------------
redis_memory_size_gb = 1
redis_alt_zone       = "europe-west1-c"
